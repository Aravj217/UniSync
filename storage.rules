rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event posters: readable by anyone, writable by organizers and admins
    match /event_posters/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /posters/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
